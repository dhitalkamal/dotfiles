{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_EVALS_DIR": "/Users/kamaldhital/.claude/evals",
    "CLAUDE_HEADLESS_DIR": "/Users/kamaldhital/.claude/headless",
    "CLAUDE_HEADLESS_LOG_DIR": "/Users/kamaldhital/.claude/logs/headless",
    "CLAUDE_ORCHESTRATION_DIR": "/Users/kamaldhital/.claude/orchestration",
    "CLAUDE_PENDING_DIR": "/Users/kamaldhital/.claude/pending",
    "CLAUDE_ROUTINES_DIR": "/Users/kamaldhital/.claude/routines",
    "EDITOR": "code --wait",
    "MAX_MCP_OUTPUT_TOKENS": "20000",
    "VISUAL": "code --wait"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(fd *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(date)",
      "Bash(open *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(make *)",
      "Bash(brew *)",
      "Bash(docker *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree *)",
      "Bash(git clean -n*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view *)",
      "Bash(gh repo clone *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh browse *)",
      "Bash(gh auth status)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(awk *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "Bash(git push origin +*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push origin develop)",
      "Bash(git push origin develop *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(gh repo delete *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(chmod -R 777 *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:attention:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/review-commit.sh",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "statusMessage": "Reviewing the commit that just landed..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/file-size-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking file size..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-tooling-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking tooling write gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-policy-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking worktree policy..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/advisor-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking mcp advisor gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-pull.sh",
            "timeout": 30,
            "statusMessage": "Pulling latest before push..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-branch-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking branch protection..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-readiness-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking pr readiness..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:prompt:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:end:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-exec-mode.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:start:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/feature-workflow-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking feature workflow gate..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:idle:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat 2>/dev/null); tp=$(printf '%s' \"$input\" | sed -n 's/.*\\\"transcript_path\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p' | head -n1); p=$PPID; n=0; while [ \"$n\" -lt 15 ]; do case \"$p\" in ''|*[!0-9]*|0|1) break;; esac; t=$(ps -o tty= -p \"$p\" 2>/dev/null | tr -d ' '); if [ -n \"$t\" ] && [ \"$t\" != '??' ] && [ -w \"/dev/$t\" ]; then printf '\\033]9;conterm-agent:claude:prompt:%s\\a' \"$tp\" > \"/dev/$t\" 2>/dev/null; break; fi; p=$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' '); n=$((n+1)); done; exit 0 # conterm"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".cache",
      ".pnpm-store",
      ".yarn/cache",
      ".uv-cache",
      "node_modules"
    ],
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "language": "english",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "in-process",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
