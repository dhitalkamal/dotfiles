{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": false,
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_EVALS_DIR": "~/.claude/evals",
    "CLAUDE_HEADLESS_DIR": "~/.claude/headless",
    "CLAUDE_HEADLESS_LOG_DIR": "~/.claude/logs/headless",
    "CLAUDE_ORCHESTRATION_DIR": "~/.claude/orchestration",
    "CLAUDE_PENDING_DIR": "~/.claude/pending",
    "CLAUDE_ROUTINES_DIR": "~/.claude/routines",
    "EDITOR": "code --wait",
    "MAX_MCP_OUTPUT_TOKENS": "20000",
    "VISUAL": "code --wait"
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(fd *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(date)",
      "Bash(open *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(yarn test *)",
      "Bash(yarn lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(make *)",
      "Bash(brew *)",
      "Bash(docker *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree *)",
      "Bash(git clean -n*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view *)",
      "Bash(gh repo clone *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh browse *)",
      "Bash(gh auth status)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(awk *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(gh repo delete *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(chmod -R 777 *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)"
    ]
  },
  "model": "claude-sonnet-5",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "foundry-query-readonly",
    "foundry-schema-designer",
    "foundry-migration",
    "foundry-ops-tuning",
    "foundry-observability",
    "foundry-vector",
    "foundry-memory",
    "foundry-design-advisor"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-decorative-chars.sh",
            "timeout": 10,
            "statusMessage": "Checking for decorative characters..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/file-size-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking file size..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-tooling-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking tooling write gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-pull.sh",
            "timeout": 30,
            "statusMessage": "Pulling latest before push..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-branch-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking branch protection..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-readiness-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-exec-mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "A `git commit` just ran and cannot be blocked at this point - it is already committed. Review the commit that just landed (`git show HEAD --stat` and `git diff HEAD~1 HEAD`) for high-confidence, serious problems: correctness bugs that would break the build or runtime, security issues (committed secrets/keys, injection, broken auth), and obviously incomplete or debug code (leftover console.log/print debugging, large commented-out blocks). Also run the security-advisor scan_secrets tool against the repo root (git rev-parse --show-toplevel). Be fast and pragmatic. If you find a serious problem, flag it clearly in one or two concise lines and suggest a fix-up (amend if not yet pushed, otherwise a follow-up commit) - this is advisory only, you cannot undo the commit yourself. If you cannot access these tools due to a permission restriction, say so in one line and stop - nothing to block either way. Do NOT flag style, formatting, or subjective preferences.",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "model": "claude-sonnet-5",
            "statusMessage": "Reviewing the commit that just landed..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/feature-workflow-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking feature workflow gate..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".cache",
      ".pnpm-store",
      ".yarn/cache",
      ".uv-cache",
      "node_modules"
    ],
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "language": "english",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "teammateMode": "in-process",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
