{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 7,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MAX_MCP_OUTPUT_TOKENS": "20000",
    "EDITOR": "code --wait",
    "VISUAL": "code --wait",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv pip *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(python manage.py *)",
      "Bash(python3 manage.py *)",
      "Bash(yarn *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose down *)",
      "Bash(uv run python manage.py showmigrations *)",
      "Bash(uv run python manage.py migrate --check)",
      "Bash(env -u VIRTUAL_ENV uv run --extra dev pre-commit run --all-files)",
      "Bash(brew install *)",
      "Bash(flutter clean *)",
      "Read(package.json)",
      "Read(pyproject.toml)",
      "Read(tsconfig.json)",
      "Read(CLAUDE.md)",
      "Read(.gitignore)",
      "Read(README.md)",
      "Read(.env.example)",
      "Read(**/.env.example)",
      "Read(/Users/kamaldhital/**)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git push --force)",
      "Bash(docker system prune *)",
      "Read(services_credentials/*)",
      "Read(**/secrets/**)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git clone *)",
      "Bash(uv run python manage.py migrate *)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-7[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-decorative-chars.sh",
            "timeout": 10,
            "statusMessage": "Checking for decorative characters..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-bash-check.sh",
            "timeout": 10,
            "statusMessage": "Running pre-bash checks..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-pull.sh",
            "timeout": 30,
            "statusMessage": "Pulling latest changes before push..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-claude-md.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/workflow-enforce.sh",
            "timeout": 10,
            "statusMessage": "Enforcing prompt workflow..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true
}
